# PostgreSQL (local via docker-compose)
DATABASE_URL=""

# API
PORT=3001

# AUTH
AUTH_PROVIDER="legacy"
KEYCLOAK_URL="http://localhost:8081"
KEYCLOAK_REALM="infradesk"
KEYCLOAK_JWKS_URI=""
KEYCLOAK_ISSUER=""
KEYCLOAK_ADMIN="admin"
KEYCLOAK_ADMIN_PASSWORD="admin"

# JWT (usado quando AUTH_PROVIDER=legacy)
JWT_SECRET=""
JWT_EXPIRES_IN="15m"

# CORS
CORS_ORIGIN="http://localhost:*"

# Worker
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=3000
WORKER_MAX_CONCURRENCY=2

# Log
LOG_LEVEL=info

# Sessões (HMAC dos refresh tokens) e assinatura de cookies
SESSION_SECRET=""
COOKIES_SECRET=""
