# PostgreSQL (local via docker-compose)
DATABASE_URL=""

# API
PORT=3001

# JWT
JWT_SECRET=""
JWT_EXPIRES_IN=""


# CORS (separar por vírgula para múltiplos origens)
CORS_ORIGIN="http://localhost:*"

# Worker
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=3000
WORKER_MAX_CONCURRENCY=2


# Nível de log
LOG_LEVEL=info

# Sessões (HMAC dos refresh tokens) e assinatura de cookies
SESSION_SECRET=""
COOKIES_SECRET=""